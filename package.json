{
  "name": "itjun-fairy-tale",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "node server/index.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "play": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "npm run build && electron .",
    "desktop:run": "electron .",
    "desktop:test": "node scripts/test-desktop.mjs",
    "icons": "node scripts/build-icons.mjs",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "chart.js": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5",
    "vite": "8.3.5"
  },
  "description": "花园王国：来自小画家作品的亲子彩笔探险",
  "main": "desktop/main.mjs",
  "author": {
    "name": "黄荣君",
    "email": "l1091462907@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itjun/itjun-fairy-tale.git"
  },
  "homepage": "https://github.com/itjun/itjun-fairy-tale",
  "bugs": {
    "url": "https://github.com/itjun/itjun-fairy-tale/issues"
  }
}
